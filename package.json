{
  "displayName": "Homebridge Mammotion",
  "name": "homebridge-mammotion",
  "version": "0.2.0",
  "description": "Homebridge control for Mammotion mowers using the official Mammotion API",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "scripts/probe-official-api.js",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc -w",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "test": "npm run build && tsc --project tsconfig.test.json && vitest run"
  },
  "engines": {
    "homebridge": ">=1.8.0",
    "node": ">=20.12.0"
  },
  "keywords": [
    "homebridge-plugin",
    "mammotion",
    "luba",
    "yuka"
  ],
  "author": "Tom Willmot <tom@willmot.co.uk>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmot/homebridge-mammotion.git"
  },
  "bugs": {
    "url": "https://github.com/willmot/homebridge-mammotion/issues"
  },
  "homepage": "https://github.com/willmot/homebridge-mammotion#readme",
  "homebridge": {
    "pluginAlias": "Mammotion",
    "platform": "Mammotion"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.75"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.22.0",
    "homebridge": "^2.5.0",
    "rimraf": "^6.1.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  }
}
